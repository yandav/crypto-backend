# 数据库配置
DATABASE_URL=postgresql+psycopg2://postgres:123456@localhost:5432/crypto_monitor
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=3600

# API配置
API_RATE_LIMIT=100
API_TIMEOUT=30

# 数据清理配置
DATA_RETENTION_DAYS=30

# 定时任务配置
PRICE_UPDATE_INTERVAL=1
OPEN_INTEREST_UPDATE_INTERVAL=1

# CORS配置
CORS_ORIGIN=http://localhost:5173

# 服务配置
PORT=5000
DEBUG=True 